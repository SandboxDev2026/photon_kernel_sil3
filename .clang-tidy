# clang-tidy 静态分析配置 — photon_kernel_sil3_v414
# 依据《人工智能工程约束法案》V4.14 Final 第十条（开发阶段：静态分析）
# 版本锁定：clang-tidy >= 14.0.0（与编译器版本约束一致，见 CMakeLists.txt）
# 运行：clang-tidy -p build include/photon_kernel/act/*.hpp src/act/*.cpp
#       clang-tidy -p build include/photon_kernel/sandbox/*.hpp src/sandbox/*.cpp

Checks: >
  -*,
  bugprone-*,
  performance-*,
  readability-*,
  clang-analyzer-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-auto,
  -readability-magic-numbers,
  -readability-identifier-length,
  -bugprone-easily-swappable-parameters

WarningsAsErrors: ''

HeaderFilterRegex: 'photon_kernel/.*'

AnalyzeTemporaryDtors: false

FormatStyle: none

CheckOptions:
  - key: readability-braces-around-statements.ShortStatementLines
    value: '2'
  - key: bugprone-narrowing-conversions.IgnoreConversionFromTypes
    value: 'size_t'
  - key: performance-unnecessary-value-param.AllowedTypes
    value: 'std::string;std::vector'
